# Copy to deploy/deploy.env (git-ignored).

# Where images are pushed; the cluster must be able to pull from here.
# e.g. ghcr.io/meiyuchi, docker.io/meiyuchi, registry.example.com/mela
REGISTRY=

# Optional
# KUBE_CONTEXT=my-cluster       # defaults to kubectl's current context
# NAMESPACE=mela
# RELEASE=mela
# PLATFORM=linux/amd64          # the cluster nodes' architecture (linux/arm64 for ARM nodes)
# VALUES_FILE=deploy/values.local.yaml   # extra Helm values (household names, storage class, ...)
