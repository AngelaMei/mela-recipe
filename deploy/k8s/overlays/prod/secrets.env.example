# Copy to secrets.env (git-ignored) and fill in. Generate random values with:
#   openssl rand -base64 32
POSTGRES_PASSWORD=
# The shared passcode the two of you type once per phone
MELA_PASSCODE=
# Signs the session cookie
SESSION_SECRET=
# YouTube Data API v3 key (videos.list?part=snippet). Leave empty to disable.
YOUTUBE_API_KEY=
