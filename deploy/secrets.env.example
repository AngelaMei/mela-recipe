# Copy to deploy/secrets.env (git-ignored) and fill in. Random values:
#   openssl rand -base64 32
#
# Note: POSTGRES_PASSWORD is only applied when the database is first created.
# Changing it later needs ALTER USER in Postgres as well.
POSTGRES_PASSWORD=
# The shared passcode you both type once per phone
MELA_PASSCODE=
# Signs the session cookie (16+ characters). Changing it signs everyone out.
SESSION_SECRET=
# YouTube Data API v3 key, for "Import from the video description". Leave empty to disable.
YOUTUBE_API_KEY=
